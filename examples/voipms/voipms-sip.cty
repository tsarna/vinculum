// Scrape SIP account registration status and set a labeled gauge per account.
// get_all_registrations() and get_subaccounts() are siblings in this namespace,
// so they are called by their bare names.
//
// The scrape is driven by the sub-account ROSTER, not by the registration list.
// getRegistrationStatus only returns accounts that are currently registered, so
// a loop over it can only ever write 1s — and because a labeled gauge child
// cannot be removed once created, an account that deregisters would keep
// exporting its last value of 1 forever. Walking the roster instead means every
// known account gets an explicit 1 or 0 on every scrape, which is what makes
// `== 0` alerting and a "how many are registered" sum possible at all.
namespace voipms

func scrape_sip_accounts(ctx: ctx) {
    var registrations = get_all_registrations(ctx)
    var accounts = get_subaccounts(ctx)

    for acct in accounts {
        var labels = {account_id = acct.account}
        var registered = 0
        for reg in registrations {
            if reg.account == acct.account {
                registered = 1
                break
            }
        }
        log::info("sip_account", {labels = labels, registered = registered})
        set(metric.voipms_sipaccount_registered, registered, labels)
    }
}
