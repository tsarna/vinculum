// HTTP wrappers for the VoIP.ms REST API.
//
// Each call resolves against the client.voipms client defined in voipms-api.vcl,
// asks for JSON, and returns the relevant slice of the response body.
//
// These live in the `voipms` namespace, so they are callable from VCL as
// voipms::get_balance(…) and by their bare names from the other .cty files in
// this namespace.
namespace voipms

// Reseller account balance. Pass callstats = true to include call statistics
// (calls_total, spent_total) in the response.
func get_balance(ctx: ctx, callstats) {
    return http::must(http::get(ctx, client.voipms, "?method=getBalance", {
        as = "json", query = {advanced = callstats}
    })).body.balance
}

// All sub-accounts (clients) of the reseller.
func get_clients(ctx: ctx) {
    return http::must(http::get(ctx, client.voipms, "?method=getClients", {
        as = "json"
    })).body.clients
}

// A single client's balance-threshold configuration.
func get_client_threshold(ctx: ctx, client_id) {
    return http::must(http::get(ctx, client.voipms, "?method=getClientThreshold", {
        as = "json", query = {client = client_id}
    })).body.threshold_information
}

// Whether one SIP sub-account currently has a device registered, as the raw
// "yes"/"no" string the API returns.
//
// getRegistrationStatus is a PER-ACCOUNT method and the `account` parameter is
// not optional in any useful sense. Called without it, it answers with an
// aggregate that carries no `registrations` key at all:
//
//     {"status":"success","rerouted":0,"from_server_pop":0,"registered":"no"}
//
// Reading `.registrations` off that throws "This object does not have an
// attribute named registrations" — which is exactly what the previous
// get_all_registrations() did, and why the scrape died outright whenever
// nothing happened to be registered. `registered` is always present, both
// with and without the parameter, so this is the field to trust.
func get_registration_status(ctx: ctx, account_id) {
    return http::must(http::get(ctx, client.voipms, "?method=getRegistrationStatus", {
        as = "json", query = {account = account_id}
    })).body.registered
}

// Every SIP sub-account on the reseller account, registered or not. This is the
// roster the registration scrape walks in order to report a 0: a gauge that is
// only ever set to 1 latches at 1 forever, because there is no way to remove a
// labeled child once it exists.
//
// WARNING: each entry carries that sub-account's SIP `password` in plaintext,
// along with its caller-ID number. Never log this response, and never return it
// anywhere it might be logged — take the fields you need (`account`) and drop
// the rest. A log shipper will happily persist the whole thing for months.
func get_subaccounts(ctx: ctx) {
    return http::must(http::get(ctx, client.voipms, "?method=getSubAccounts", {
        as = "json"
    })).body.accounts
}

// A single client sub-account's balance, including call statistics.
func get_reseller_balance(ctx: ctx, client_id) {
    return http::must(http::get(ctx, client.voipms, "?method=getResellerBalance", {
        as = "json", query = {client = client_id}
    })).body.balance
}
