# Where the compose broker in ci/brokers.yml can be reached, in the form the
# rabbitmq integration tests read. Source it with `set -a` so the assignments are
# exported:
#
#   set -a; . ci/rabbitmq.env; set +a
#   go test -race -tags integration ./clients/rabbitmq/...
#
# Not to be confused with ./rabbitmq.env in the repository root, which is
# gitignored and holds credentials for whatever broker a developer keeps
# elsewhere. These credentials are in the definitions file next to them; they
# guard nothing.

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_TLS_PORT=5671
RABBITMQ_VHOST=vinculum

RABBITMQ_USER=vinculum
RABBITMQ_PASS=vinculum

# May consume, may not publish or declare — the permission-failure tests skip
# without it. Its grants are in ci/rabbitmq/definitions.json.
RABBITMQ_RO_USER=vinculum_ro
RABBITMQ_RO_PASS=vinculum_ro

# The reconnect tests close the client's connections through this. The
# management user defaults to RABBITMQ_USER, which is tagged administrator.
RABBITMQ_MGMT_URL=http://localhost:15672

# A name in the server certificate's SAN, so verification can succeed. The CA is
# the private one ci/rabbitmq/setup.sh issued, which is why this path has to be
# absolute: a test binary's working directory is its own package, not the
# repository root.
#
# Naming a real file here is also what puts the TLS tests on the private-CA
# branch: TestRMQ_Phase4_TLSWithCATrust runs, and the insecure_skip_verify
# test's no_trust_fails half gets a chain nothing trusts, which is the only way
# to make a verification failure certain. The cost is that
# TestRMQ_Phase4_TLSSystemTrust skips — no container gets a publicly-trusted
# certificate, so the system-trust path can only be covered by pointing the
# suite at a broker that has one. What it would cover beyond the private-CA
# test is Go's default root pool, which is not vinculum's code; running the
# other two against a chain we control is worth more than running that one.
RABBITMQ_TLS_SERVERNAME=localhost
RABBITMQ_CA_CERT="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)/rabbitmq/certs/ca.pem"
